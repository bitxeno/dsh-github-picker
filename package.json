    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
